#lang rhodium
// Mixes a retained Queue with ordinary arithmetic, control gating, and clocked state.
// SPDX-License-Identifier: Apache-2.0

import lib("flow/queue.rhdl") open

sync_circuit MixedSelective(depth :: PosInt, pipe :: Boolean, flow :: Boolean):
  input payload: Bits(8)
  input valid: Bool
  input ready: Bool
  input enable: Bool
  output input_ready: Bool
  output output_valid: Bool
  output output_payload: Bits(8)
  output occupancy: Bits(index_width(depth + 1))
  output phase: Bits(8)
  reg offset(~init: bits(1, 8))
  offset <== offset + bits(1, 8)
  inst queue_instance(Queue(Bits(8), depth, ~pipe: pipe, ~flow: flow))
  queue_instance.ingress.valid <== valid & enable
  queue_instance.ingress.bits <== payload + offset
  queue_instance.egress.ready <== ready
  input_ready <== queue_instance.ingress.ready & enable
  output_valid <== queue_instance.egress.valid
  output_payload <== queue_instance.egress.bits ^ offset
  occupancy <== queue_instance.count
  phase <== offset

fun elaborate_mixed(depth, pipe, flow):
  elaborate_with_top(MixedSelective(depth, pipe, flow), ~constructs: #true)

export elaborate_mixed
