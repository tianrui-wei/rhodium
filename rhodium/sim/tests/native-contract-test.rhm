#lang rhombus
// Tests native range coverage and dependency/effect rejection before execution extraction.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/main.rhm" open
  "../objects.rhm" open
  "../native-contract.rhm" open

def contract = ConstructContract(
  [ConstructPort("a", "input", Bits(8)), ConstructPort("z", "output", Bits(8))],
  [ConstructDependency(PortLeaf("z"), [PortLeaf("a")])], [], [], [])
fun implementation(inputs, outputs): NativeImplementation(contract, NativeFunction(1, inputs, outputs), [])
fun verify(value): verify_native_implementation(value, contract, "top/test")
check:
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [0])])) ~is #void
  verify(implementation([["a", 1, 8]], [NativeOutput("z", 0, 8, 0, [0])])) ~throws "input range exceeds"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 7, 0, [0])])) ~throws "does not cover"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 9, 0, [0])])) ~throws "output range exceeds"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [1])])) ~throws "dependency input slot"
  verify(implementation([#false], [NativeOutput("z", 0, 8, 0, [0])])) ~throws "dependency input slot"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 5, 0, [0]), NativeOutput("z", 4, 4, 1, [0])])) ~throws "overlapping"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [0], 1, 8)])) ~throws "query width"
  verify(implementation([["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [NativeSlice(0, 0, 8)])])) ~throws "queue payload projection"

def independent = ConstructContract(contract.ports, [ConstructDependency(PortLeaf("z"), [])], [], [], [])
check:
  verify_native_implementation(NativeImplementation(independent, NativeFunction(1, [["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [0])]), []), independent, "top/test") ~throws "undeclared combinational dependency"
  verify(NativeImplementation(contract, NativeFunction(1, [["a", 0, 8]], [NativeOutput("z", 0, 8, 0, [0])]), ["extra"])) ~throws "every declared effect"
